{
  "name": "explorer",
  "engines": {
    "node": ">=24 <25"
  },
  "version": "3.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "pretest:e2e": "playwright install chromium firefox",
