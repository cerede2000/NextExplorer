    "@onlyoffice/document-editor-vue": "^1.6.1",
    "@uppy/core": "^5.2.0",
    "@uppy/drop-target": "^4.1.0",
    "@uppy/tus": "^5.1.1",
    "@uppy/xhr-upload": "^5.1.1",
