# NextExplorer, configuration.
#
# One KEY=value per line, no export, no shell expansion — systemd reads this
# file itself. After a change: systemctl restart nextexplorer
#
# Everything the application understands is listed at
# https://cerede2000.github.io/NextExplorer/configuration/environment
#
# This file is written once, by the first install. Updates never touch it.

# --- Where it listens -------------------------------------------------------
PORT=@PORT@
ADDRESS=0.0.0.0

# The address people type, which is what cookies and OIDC callbacks are built
# from. Set it as soon as there is a name or a reverse proxy in front.
#PUBLIC_URL=https://files.example.com

# Set this behind a reverse proxy so the address recorded and the HTTPS state
# are the person's rather than the proxy's. `loopback,uniquelocal` is the safe
# starting point; see the reverse proxy guide.
#TRUST_PROXY=loopback,uniquelocal

# --- Where things live ------------------------------------------------------
# Each folder inside VOLUME_ROOT shows up as a volume, the way a drive does in
# a file manager. Mount what you already have there — an NFS or SMB share
# mounted on this machine is a volume without this program speaking a protocol.
VOLUME_ROOT=@VOLUME_ROOT@

# The database, the keys, what cannot be made again. Back this one up.
CONFIG_DIR=@CONFIG_DIR@

# Thumbnails and the search index. Disposable: losing it costs time, not data.
CACHE_DIR=@CACHE_DIR@

# --- Who gets in ------------------------------------------------------------
AUTH_ENABLED=true
# local, oidc, or both.
AUTH_MODE=local

# Left to the application, which draws one on the first start and keeps it in
# CONFIG_DIR. Set it here only to share sessions across several machines.
#SESSION_SECRET=

# --- The terminal -----------------------------------------------------------
# Off, and deliberately so outside a container: in the image this opens a shell
# inside the container, here it would open one on this machine, as the account
# the service runs as. Turn it on only if that is what you want.
TERMINAL_ENABLED=false

# --- A record of what people do ---------------------------------------------
# Off by default. Switch it on in Settings rather than here; these two are only
# the values it starts from.
#ACTIVITY_ENABLED=true
#ACTIVITY_RETENTION_DAYS=90
