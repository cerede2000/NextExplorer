{
  "about": [
    "Every finding scripts/parity.mjs makes must match a rule here, or the script fails.",
    "Four verdicts: OURS (never goes upstream), SHAPE (same capability, different",
    "structure \u2014 nxzai#373 placed this outside the plan), PORT (must be reversed, with",
    "its batch), DONE (reversed, with its pull request).",
    "",
    "The first matching rule wins, so the specific ones come first. `match` is a",
    "regular expression unless `exact` is true.",
    "",
    "There is deliberately no catch-all at the end. Anything new this instrument finds",
    "is unclassified, and unclassified is a failure \u2014 which is the only reason this",
    "file is worth having."
  ],
  "rules": [
    {
      "axis": "*",
      "match": "^\\.github/workflows/(build-image|ci|cleanup-packages|dockerhub-description|measure-solid-7z|package-integration|package-standalone|refresh-images)\\.yml$",
      "verdict": "OURS",
      "note": "our release and image workflows; upstream publishes its own"
    },
    {
      "axis": "*",
      "match": "^(packaging/|render\\.yaml|demo/|\\.nvmrc|\\.git-blame-ignore-revs|coverage-thresholds\\.json)",
      "verdict": "OURS",
      "note": "the standalone archive, the demo, and our own repository furniture"
    },
    {
      "axis": "*",
      "match": "^(UPSTREAM|TODO|REVIEW|README)\\.md$",
      "verdict": "OURS",
      "note": "our planning documents and this fork's own readme"
    },
    {
      "axis": "*",
      "match": "^scripts/(parity\\.mjs|parity-manifest\\.json|check-batch\\.sh|check-commit-tests\\.sh|check-endpoints\\.mjs|measure-solid-7z\\.mjs|node-major-notice\\.mjs|prune-dockerhub\\.js|prune-images\\.js|version\\.js)$",
      "verdict": "OURS",
      "note": "our own tooling, this instrument included"
    },
    {
      "axis": "*",
      "match": "^docs/(testing/|installation/(demo|standalone)\\.md|reference/releases\\.md)",
      "verdict": "OURS",
      "note": "our test notes, the installation paths only this fork offers, and our release history"
    },
    {
      "axis": "*",
      "match": "\\.(spec|test)\\.[jt]s$",
      "verdict": "OURS",
      "note": "our frontend suites: upstream runs no frontend test runner, so these cannot execute there. What they assert travels as a backend test where it can"
    },
    {
      "axis": "*",
      "match": "^(frontend/(vitest\\.setup\\.js|e2e/)|backend/(vitest\\.config\\.js|tests/(fixtures|helpers|setup)/)|eslint\\.config\\.mjs)",
      "verdict": "OURS",
      "note": "our test and lint wiring"
    },
    {
      "axis": "*",
      "match": "^docker/(check-heic\\.cjs|verify-7zip-password\\.js|verify-ffmpeg\\.sh)$",
      "verdict": "OURS",
      "note": "scripts that check our own image build"
    },
    {
      "axis": "*",
      "match": "^(frontend/src/components/InlineQuickActions\\.vue|frontend/src/stores/quickActions\\.js|frontend/src/config/quickActions\\.js|frontend/src/composables/useFolderQuickActions\\.js)(:|$)",
      "verdict": "OURS",
      "note": "the inline quick-actions menu was offered upstream in nxzai#333 and closed. It stays ours unless the maintainer asks for it"
    },
    { "axis": "env", "match": "^DEMO_", "verdict": "OURS", "note": "our Render demo" },
    {
      "axis": "file-upstream",
      "match": ".",
      "verdict": "OURS",
      "note": "upstream has it and we do not: nothing to reverse, kept visible so we never quietly drop a file upstream adds"
    },
    {
      "axis": "route-upstream",
      "match": ".",
      "verdict": "OURS",
      "note": "a route upstream has and we do not"
    },
    {
      "axis": "*",
      "match": "^frontend/src/stores/files/",
      "verdict": "SHAPE",
      "note": "the file store split into modules; upstream's fileStore.js holds the same capability"
    },
    {
      "axis": "*",
      "match": "^(frontend/src/views/FolderView\\.vue|frontend/src/components/MiddleEllipsis\\.vue|frontend/src/components/FolderViewToolbar\\.vue|frontend/src/layouts/BrowserLayout\\.vue)(:|$)",
